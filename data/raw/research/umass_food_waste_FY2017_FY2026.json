  "metric_definitions": {
    "source_reduction": "Food waste prevented before disposal or redistribution.",
    "overproduction": "Prepared food exceeding a defined consumption or service requirement; source definitions may vary.",
    "plate_waste": "Food discarded after service to diners.",
    "pre_consumer_waste": "Waste occurring before diners consume it; may include prep scraps and unserved food.",
    "anaerobic_diversion": "Food scraps collected for energy/nutrient recovery; not food-waste prevention.",
    "donation": "Edible surplus redistributed; not necessarily avoided production.",
    "tracked_production": "Food production measured by a system, not food wasted or saved.",
    "tracked_consumption": "Consumption quantity recorded or estimated by a system, not waste avoided.",
    "waste_per_swipe": "Food-waste mass normalized by meal transactions; distinct from annual mass or unique diners.",
    "cost_savings": "Monetary result; cannot be converted into kilograms without additional data."
  },
